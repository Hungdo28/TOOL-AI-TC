HOST=0.0.0.0
PORT=3000

# Google Sheet đang được n8n sử dụng.
GOOGLE_SPREADSHEET_ID=1oyWC0Z12SjiAVH8P023HjQtnHFprKFCQgmBCqqytZW0
GOOGLE_SHEET_NAME=Trang tính1
GOOGLE_SHEET_ID=0
GOOGLE_HEADER_ROW=1

# Chọn một trong các cách khai báo credential. Để upload file bằng tài khoản
# Google cá nhân, chạy: py BE/scripts/setup_google_oauth.py
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_AUTHORIZED_USER_JSON={"type":"authorized_user",...}

# Thư mục Drive dùng khi người dùng import file. Với service account nên dùng
# thư mục nằm trong Shared Drive vì service account không có quota My Drive.
GOOGLE_DRIVE_FOLDER_ID=
# private | anyone. Nên dùng private nếu tài liệu có dữ liệu nhạy cảm.
GOOGLE_DRIVE_SHARE_MODE=private

ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://quanlv.io.vn
ENFORCE_ROLE_HEADER=true
MAX_FILE_SIZE_MB=20
MAX_TOTAL_FILE_SIZE_MB=50

# Webhook n8n kích hoạt luồng sinh Testcase / AI
N8N_WEBHOOK_URL=https://vdtc-hungdv.tailfb2503.ts.net:8443/webhook/luong-chuc-nang

# Shared secret để n8n gọi ngược /api/tasks/ai-callback (bắt buộc, nếu thiếu backend sẽ từ chối callback).
# Sinh token bằng: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Nhớ cấu hình header "X-Callback-Token: <giá trị này>" trong node HTTP Request của n8n.
AI_CALLBACK_TOKEN=
